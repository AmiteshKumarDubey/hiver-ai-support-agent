# API Keys for LLM generation and LLM-as-Judge evaluation
# Provide at least one key if you wish to run live LLM evaluation.
# If no key is provided, the system automatically runs using local open-source models & fallbacks.

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Default configuration
LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
LLM_JUDGE_MODEL=gpt-4o-mini
ESCALATION_CONFIDENCE_THRESHOLD=0.65
